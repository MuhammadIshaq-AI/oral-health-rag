# Pick one chat provider: gemini (default) | groq | hf | openrouter | ollama
LLM_PROVIDER=gemini
# Optional: override the provider's default model
LLM_MODEL=gemini-3.6-flash

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Alternatives
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Free token: https://huggingface.co/settings/tokens
HF_TOKEN=
# Free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
