# ---- Experiment config (YAML under configs/) ------------------------------
# The config file selects retrieval mode, LLM provider/model and prompt version.
EXPERIMENT_CONFIG=configs/default.yaml

# ---- LLM providers ----------------------------------------------------------
# Local (default, fully reproducible): Ollama
OLLAMA_BASE_URL=http://localhost:11434
# API providers — setting a key does nothing unless a config selects that provider.
# WARNING: API providers send user questions and retrieved passages off this machine.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ---- Retrieval ----------------------------------------------------------------
VECTOR_STORE=qdrant            # qdrant | faiss
QDRANT_URL=http://localhost:6333
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
DEVICE=auto                    # auto | cuda | cpu

# ---- Speech -------------------------------------------------------------------
WHISPER_MODEL=small            # small | medium | large-v3
WHISPER_COMPUTE_TYPE=auto
TTS_ENABLED=true
PIPER_VOICE=en_GB-alba-medium

# ---- Research logging ---------------------------------------------------------
LOG_DIR=data/logs
DATA_DIR=data
